{
  "name": "studyzone-auth",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-06-26",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "ff2b0d83-d443-4692-8955-2c6793808cd3"
    },
    {
      // The archive of downloaded designs (Poster Maker, Thumbnail Gen): files in chunks, kept apart from the users' database
      "binding": "ARCHIVE",
      "database_name": "hc-archive",
      "database_id": "a274c4e8-0b2b-4d2a-9d3d-a9f149ea7e2a"
    }
  ]
}