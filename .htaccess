# Security response headers.
# Requires mod_headers and AllowOverride All (or at least FileInfo).

# Force HTTPS. The site was served over plain http:// as well, which lets anyone
# on the path rewrite the page -- and injected script can read the session token
# out of localStorage and capture the password as it is typed. The second
# condition covers running behind a proxy that terminates TLS upstream.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)  [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Deny dotfiles. .git is present on the server (deployed by clone/pull) and is
# currently only blocked by the host's default config -- this makes it explicit,
# and 404 rather than 403 so it does not confirm the directory exists.
RedirectMatch 404 "/\.(git|env|htaccess|htpasswd)"

# ---------------------------------------------------------------------------
# Compression. text/HTML/CSS/JS is ~1.1MB and was served uncompressed. Brotli
# where available, gzip otherwise. Both skip already-compressed binaries.
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
        application/javascript application/json application/xml \
        image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml \
        image/svg+xml application/manifest+json
</IfModule>

# ---------------------------------------------------------------------------
# Caching. The HTML embeds app state and must always revalidate; the versioned
# static asset (html2canvas 1.4.1) and images/fonts can sit in cache. There are
# no filename-hashed assets, so no immutable year-long TTLs here.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css|png|jpg|jpeg|svg|webp|woff2?|ttf|otf|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # index.html is served for "/" without a .html suffix -- catch that too.
    <If "%{REQUEST_URI} =~ m#^/?$#">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </If>
</IfModule>

<IfModule mod_headers.c>
    # HSTS for two years, covering this host and any of its subdomains. It does
    # NOT affect sibling subdomains of hcsyria-apps.org -- includeSubDomains
    # applies only to subdomains of the issuing host (post-gen.*), of which
    # there are none, so it is safe. `preload` is intentionally omitted: it is a
    # near-irreversible commitment and requires the apex hcsyria-apps.org to
    # also serve HSTS over HTTPS, which is not under this app's control. Add it
    # only after the apex is verified HTTPS-only (see the deploy notes).
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

    # Block MIME-type sniffing.
    Header always set X-Content-Type-Options "nosniff"

    # Disallow framing (clickjacking). Use SAMEORIGIN if you ever embed this.
    Header always set X-Frame-Options "DENY"

    # Don't leak the full URL to third parties.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # No need for camera/mic/geolocation in this app.
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Cross-origin isolation. Keep this document in its own browsing-context
    # group and stop its resources being embedded off-origin. COEP is left off
    # deliberately -- it would block the data:/blob: images and the cross-origin
    # AI-conversion Worker call, and nothing here needs SharedArrayBuffer.
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Content Security Policy.
    #
    # The inline scripts are allowed by sha256 hash rather than 'unsafe-inline',
    # so injected script is blocked while the app's own code still runs. The
    # hashes cover the exact bytes of each inline block, so they go stale on any
    # JavaScript edit and the app then silently fails to boot. Regenerate with:
    #
    #     python tools/csp-hashes.py
    #
    # Inline event handlers cannot be hashed, only allowed wholesale by
    # 'unsafe-inline' -- keep them out of index.html.
    #
    # style-src keeps 'unsafe-inline' for the many inline style="..." attributes.
    # CSS injection is a far smaller risk than script injection, and removing it
    # would mean rewriting the markup.
    #
    # data: is needed for the embedded base64 fonts and images.
    # connect-src: the auth Worker is gone -- the API is same-origin now, so
    # 'self' covers it. The remaining external origin is the AI image
    # conversion Worker, still called by Study Zone's "تحويل لستايل" button.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-ioCF6NBDF2GTvLD/i5NaJxlbRYmyVL06Lj1XGzFtwX4=' 'sha256-hcg+6l8F49DfWhyNIfsGh37hBTvb8aQSrymSHex+0RY='; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://empty-fog-2a2b.ct-aleppo3.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
